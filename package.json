{
  "name": "streamfusion",
  "version": "3.1.0",
  "description": "StreamFusion v3.1.0 - Premium Android Mobile Mirroring, Wireless Streaming, File Transfer & Control powered by scrcpy",
  "author": "Milann Sharma <https://github.com/Milannsharma>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT,ELECTRON\" -c \"cyan,magenta,yellow\" \"node --watch server/index.js\" \"vite\" \"electron .\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev:electron": "electron .",
    "start": "electron .",
    "build": "vite build",
    "build:exe": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.milannsharma.streamfusion",
    "productName": "StreamFusion v3.1.0",
    "artifactName": "StreamFusion-v3.1.0-Setup.${ext}",
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "MilannSharma",
        "repo": "StreamFusion"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "StreamFusion.ico",
      "StreamFusion.png",
      "package.json",
      "!**/*.map",
      "!node_modules/**/{test,tests,docs,*.md}"
    ],
    "extraResources": [
      {
        "from": "scrcpy-bin",
        "to": "scrcpy-bin"
      }
    ],
    "electronLanguages": [
      "en"
    ],
    "win": {
      "icon": "StreamFusion.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamFusion v3.1.0",
      "runAfterFinish": true
    }
  }
}
