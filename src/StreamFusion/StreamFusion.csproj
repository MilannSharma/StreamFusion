<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>StreamFusion</ApplicationTitle>
    <AssemblyTitle>StreamFusion</AssemblyTitle>
    <Company>StreamFusion</Company>
    <Product>StreamFusion Mobile Mirror &amp; Control</Product>
    <Description>Premium Android Mobile Mirroring, Wireless Streaming, File Transfer &amp; Control</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scrcpy-bin\**" Link="scrcpy-bin\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
